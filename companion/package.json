{
  "name": "@propperly/companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Propperly companion agent — watches local folders and syncs to Services",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "pkg:win": "pkg dist/index.js --target node18-win-x64 --output propperly-companion-win.exe",
    "pkg:mac": "pkg dist/index.js --target node18-macos-x64 --output propperly-companion-mac",
    "pkg:linux": "pkg dist/index.js --target node18-linux-x64 --output propperly-companion-linux"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pkg": "^5.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
