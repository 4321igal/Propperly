{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/**/*.ts",
    "discovery/**/*.ts",
    "../app/src/**/*.ts",
    "../storage/src/**/*.ts",
    "../data-center/src/**/*.ts"
  ]
}
